# Local redaction tuning (no cloud keys — this repo is fully offline-capable)

# Face detector: yunet | scrfd | auto | max
FACE_BLUR_DETECTOR=max

# blackout (default privacy-safe) | gaussian
FACE_BLUR_STYLE=blackout

# rect opaque boxes (default) | ellipse
FACE_BLUR_REDACTION_MASK=rect

FACE_BLUR_BYTE_TRACK=1
FACE_BLUR_ENSEMBLE=1
FACE_BLUR_ENSEMBLE_SSD=0

# Plate detector confidence (LPD-YuNet bundled)
PRIVACY_PLATE_CONFIDENCE=0.35

# Optional custom plate ONNX (HTTPS + pinned SHA-256 only)
# PRIVACY_PLATE_ONNX_MODEL_PATH=
# PRIVACY_PLATE_ONNX_SHA256=

# Optional SCRFD download (InsightFace weights); off by default
# FACE_BLUR_ALLOW_NETWORK_MODELS=0
